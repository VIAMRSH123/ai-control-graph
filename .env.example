# --- control graph database (Neon) ---
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# --- model access ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- AWS: one region, used everywhere ---
AWS_REGION=us-east-1

# collector identity — read-only (SecurityAudit). Never give this write access.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# deployer identity — used by Terraform only, as a named profile
AWS_DEPLOY_PROFILE=control-graph-deployer

# --- github evidence collector (falls back to `gh` CLI auth if unset) ---
GITHUB_TOKEN=
GITHUB_REPO=VIAMRSH123/ai-control-graph

# --- propagation tuning ---
PROPAGATION_THRESHOLD=0.45
PROPAGATION_MAX_DEPTH=3

# --- evidence freshness SLO, in days ---
EVIDENCE_MAX_AGE_DAYS=30
