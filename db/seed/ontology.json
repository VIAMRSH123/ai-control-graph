{
  "_about": [
    "The concept vocabulary that cross-framework edges are derived from.",
    "",
    "Top-level concepts are NIST AI RMF's seven trustworthiness characteristics,",
    "taken from NIST's own crosswalk document, plus one addition: management-system,",
    "which covers the organisational machinery (policy, audit, review, competence)",
    "that the trustworthiness characteristics do not describe but that both ISO",
    "standards are largely made of. That addition is ours and is marked as such.",
    "",
    "`patterns` are case-insensitive regexes matched against a control's title and",
    "statement to assign the concept. They are deterministic and reviewable, so the",
    "graph builds with no API key and the same input always yields the same tags.",
    "An LLM pass can refine these afterwards; it is not required to produce a graph."
  ],
  "concepts": [
    {
      "key": "valid-reliable",
      "label": "Valid and Reliable",
      "definition": "The system performs as intended, accurately and consistently, and this is demonstrated through testing and measurement.",
      "parent": null,
      "source": "NIST AI RMF trustworthiness characteristic"
    },
    {
      "key": "safe",
      "label": "Safe",
      "definition": "The system does not, under defined conditions, lead to a state endangering human life, health, property or the environment.",
      "parent": null,
      "source": "NIST AI RMF trustworthiness characteristic"
    },
    {
      "key": "secure-resilient",
      "label": "Secure and Resilient",
      "definition": "The system withstands adverse events and unauthorised interference, and maintains confidentiality, integrity and availability.",
      "parent": null,
      "source": "NIST AI RMF trustworthiness characteristic"
    },
    {
      "key": "accountable-transparent",
      "label": "Accountable and Transparent",
      "definition": "Information about the system is available to those who need it, and responsibility for its outcomes is assigned and traceable.",
      "parent": null,
      "source": "NIST AI RMF trustworthiness characteristic"
    },
    {
      "key": "explainable-interpretable",
      "label": "Explainable and Interpretable",
      "definition": "The mechanism and the meaning of the system's output can be described and understood in context.",
      "parent": null,
      "source": "NIST AI RMF trustworthiness characteristic"
    },
    {
      "key": "privacy-enhanced",
      "label": "Privacy-Enhanced",
      "definition": "Personal data is safeguarded through anonymity, confidentiality and control over its collection and use.",
      "parent": null,
      "source": "NIST AI RMF trustworthiness characteristic"
    },
    {
      "key": "fair-bias-managed",
      "label": "Fair with Harmful Bias Managed",
      "definition": "Harmful bias and discriminatory outcomes are identified, measured and managed across affected groups.",
      "parent": null,
      "source": "NIST AI RMF trustworthiness characteristic"
    },
